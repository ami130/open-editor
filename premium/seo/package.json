{
  "name": "@openeditor-premium/seo",
  "version": "0.1.0",
  "private": true,
  "description": "Premium plugin (19.4) — SEO Analyzer: keyword density, heading structure, readability, meta-description assessment. Read-only. Gated on 'seo'. Ships no code in the free build.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./analyze": "./src/analyze.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/guard-no-publish.mjs",
    "build": "node ../../scripts/build-premium.mjs",
    "prepack": "node ../../scripts/build-premium.mjs"
  },
  "dependencies": {
    "@openeditor-premium/runtime": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "vitest": "1.6.1"
  },
  "publishConfig": {
    "main": "./dist/index.min.js",
    "module": "./dist/index.min.js",
    "exports": {
      ".": "./dist/index.min.js",
      "./analyze": "./dist/analyze.min.js"
    }
  }
}
