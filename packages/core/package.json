{
  "name": "openeditor-text-engine",
  "version": "1.2.3",
  "private": true,
  "description": "Open Editor core engine — pure JavaScript, zero dependencies",
  "type": "module",
  "license": "MIT",
  "author": "Open Editor contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ami130/open-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ami130/open-editor#readme",
  "bugs": {
    "url": "https://github.com/ami130/open-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "contenteditable",
    "zero-dependency",
    "vanilla-js"
  ],
  "main": "./dist/open-editor.min.cjs",
  "module": "./dist/esm/index.js",
  "unpkg": "./dist/open-editor.umd.min.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/open-editor.min.cjs"
    },
    "./styles": "./dist/open-editor.css",
    "./package.json": "./package.json",
    "./locales/*": "./dist/esm/locales/*.js"
  },
  "files": [
    "dist",
    "!dist/delivery",
    "index.d.ts"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js && node scripts/extract-css.mjs",
    "build:watch": "rollup -c rollup.config.js --watch",
    "build:css": "node scripts/extract-css.mjs",
    "build:delivery": "rollup -c rollup.delivery.config.js && node scripts/build-manifest.mjs && node scripts/verify-bundles.mjs",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "rollup -c rollup.config.js && node scripts/extract-css.mjs",
    "prepublishOnly": "node ../../scripts/guard-no-publish.mjs && rollup -c rollup.config.js && node scripts/extract-css.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "jsdom": "29.1.1",
    "rollup": "4.62.0",
    "typescript": "~5.6.3",
    "vitest": "1.6.1",
    "@openeditor-premium/export-pdf": "workspace:*",
    "@openeditor-premium/export-docx": "workspace:*"
  }
}
