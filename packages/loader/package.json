{
  "name": "openeditor-text",
  "version": "2.0.0",
  "private": false,
  "description": "Open Editor \u2014 the rich text editor, delivered at runtime. Installing this puts only a small loader in node_modules; the editor engine is fetched, integrity-verified and mounted at page load.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./src/vue.js"
    },
    "./angular": {
      "types": "./src/angular.ts",
      "default": "./src/angular.ts"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "react.d.ts",
    "vue.d.ts",
    "openeditor-text-engine.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "sync:engine-types": "node scripts/sync-engine-types.mjs",
    "prepublishOnly": "npm run sync:engine-types"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "@angular/core": ">=17",
    "@angular/forms": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "1.6.1",
    "jsdom": "24.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@testing-library/react": "^16.1.0",
    "vue": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "openeditor-text-engine": "workspace:*"
  }
}
