{
  "name": "openeditor-text-react",
  "version": "1.2.0",
  "private": true,
  "description": "LEGACY (v1.x) \u2014 wraps the npm-installed engine. Superseded by openeditor-text-react@2, which wraps the runtime loader. Kept private: v1.2.0 stays on npm for existing installs.",
  "type": "module",
  "license": "MIT",
  "author": "Open Editor contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ami130/open-editor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ami130/open-editor#readme",
  "bugs": {
    "url": "https://github.com/ami130/open-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "react",
    "react-component",
    "open-editor"
  ],
  "main": "./dist/open-editor-react.min.cjs",
  "module": "./dist/open-editor-react.min.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/open-editor-react.min.js",
      "require": "./dist/open-editor-react.min.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "test": "vitest run",
    "prepack": "rollup -c rollup.config.js",
    "prepublishOnly": "node ../../scripts/guard-no-publish.mjs && rollup -c rollup.config.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "openeditor-text-engine": ">=1.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/react": "^16.1.0",
    "jsdom": "29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "4.62.0",
    "vitest": "1.6.1",
    "openeditor-text-engine": "workspace:*"
  }
}
